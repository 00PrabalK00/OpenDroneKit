# Python cache/runtime
__pycache__/
*.py[cod]

# Local outputs and temp datasets
final_toolkit_outputs/
tmp_health_test_images/

# Training workspace: keep the code, ignore the data and run artifacts.
training/data/
training/runs/
training/checkpoints/
training/sources/
*.pt
*.pth
*.onnx
*.ckpt

# Credentials — never commit. Keys live in the user profile or environment.
.env
*.key
kaggle.json
access_token
secrets.json

# Model artifacts (large): ignore all model payload folders by default
models/*
!models/README.md
!models/model_registry.json
!models/manifests/
models/manifests/*
!models/manifests/model_provenance.json
