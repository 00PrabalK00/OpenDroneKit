# OpenDroneKit Hub API.
FROM python:3.12-slim

# GDAL and PROJ are needed by rasterio and pyproj; libgl by opencv. Installed here
# rather than pulled at runtime so the image works with no network.
RUN apt-get update && apt-get install -y --no-install-recommends \
      gdal-bin libgdal-dev proj-bin libproj-dev \
      libgl1 libglib2.0-0 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first, so a source change does not invalidate the install layer.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir "psycopg[binary]" boto3 "uvicorn[standard]"

COPY core/ ./core/
COPY mission/ ./mission/
COPY services/ ./services/
COPY models/ ./models/

ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
EXPOSE 8000

# Run as a non-root user: a web-facing process should not be able to write its own code.
RUN useradd --create-home --uid 10001 odk && mkdir -p /data/storage && chown -R odk /data/storage
USER odk

CMD ["uvicorn", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
