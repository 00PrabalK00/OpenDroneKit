# Copy to .env and edit. Never commit .env.

# --- database -------------------------------------------------------------
POSTGRES_USER=odk
POSTGRES_DB=opendronekit
# Choose your own. Compose refuses to start if this is unset.
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
# Signs session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anything shorter than 32 bytes is stretched by hashing and reported as
# not deployment-grade on /health.
ODK_SECRET_KEY=
ODK_API_PORT=8000
# JSON request logs default to INFO; use WARNING for quieter deployments.
ODK_LOG_LEVEL=INFO
# Comma-separated browser origins. Empty means same-origin only.
ODK_CORS_ORIGINS=

# --- storage --------------------------------------------------------------
# "s3" uses the bundled SeaweedFS S3 gateway; "local" keeps everything on the api
# volume. The two keys become the gateway's only identity (letters, digits, - and _;
# they are written into its JSON config at start). Compose refuses to start if the
# access key is unset.
ODK_STORAGE_BACKEND=s3
ODK_S3_BUCKET=opendronekit
ODK_S3_ACCESS_KEY=change-me-s3-user
ODK_S3_SECRET_KEY=change-me-s3-password
ODK_S3_PORT=8333
