# Copy to .env and edit. Never commit .env.

# --- database -------------------------------------------------------------
POSTGRES_USER=odk
POSTGRES_DB=opendronekit
# Choose your own. Compose refuses to start if this is unset.
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
# Signs session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anything shorter than 32 bytes is stretched by hashing and reported as
# not deployment-grade on /health.
ODK_SECRET_KEY=
ODK_API_PORT=8000
# Comma-separated browser origins. Empty means same-origin only.
ODK_CORS_ORIGINS=

# --- storage --------------------------------------------------------------
# "s3" uses the bundled MinIO; "local" keeps everything on the api volume.
ODK_STORAGE_BACKEND=s3
ODK_S3_BUCKET=opendronekit
ODK_S3_ACCESS_KEY=change-me-minio-user
ODK_S3_SECRET_KEY=change-me-minio-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
