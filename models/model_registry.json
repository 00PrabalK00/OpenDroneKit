    },
    "legacy_crack_segmentation_unet": {
      "kind": "pytorch_checkpoint",
      "path": "legacy/crack_segmentation_unet.pth",
      "labels": [
        "crack"
      ],
      "score_threshold": 0.5,
      "iou_threshold": 0.0,
      "input_size": 512,
      "description": "Alternative crack segmentation checkpoint slot."
    }
