        "hotspot",
        "cell_crack",
        "soiling",
        "delamination",
        "string_fault"
      ],
      "score_threshold": 0.25,
      "iou_threshold": 0.45,
      "input_size": 640,
      "description": "PV-Multi-Defect baseline mapped to toolkit solar label schema."
